# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── LaTeX build artefacts ─────────────────────────────────────────────────────
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local

# ── Data ─────────────────────────────────────────────────────────────────────
# Processed parquet files (136 MB, 4764 files): ignored by default.
# To share them where redistribution is confirmed, add:
#   !data/clean/
# to a local .gitignore override, or remove this line and commit the folder.
data/clean/

# Raw exchange data - never commit
*.log
*.mitch
data/raw/

# External cryptocurrency feed (Appendix E) - never commit; supplied by the
# replicator at data/crypto/ or via MICRODIFFUSION_CRYPTO_DIR
data/crypto/

# Large intermediate outputs that may land in data/ during replication
data/drift_diffusion/
data/state/
data/tables/
data/figures/

# ── Local manuscript and build folders ───────────────────────────────────────
paper/
journal/

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Flat event panel (regenerated by src/data/event_panel.py)
data/data_export/

# Diagnostic-only tables and figures (regenerated; not article results)
results/diagnostics/

# ── Packaged archives: never publish ──────────────────────────────────────────
# local data bundles and any other packaged archives
*.tar.gz
*.zip
note_to_*.md
memo_to_*.md
